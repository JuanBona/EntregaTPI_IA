# Copiar este archivo a ".env" y completar con las keys reales.
# NUNCA commitear el archivo ".env" (ya está en .gitignore).

# --- LLM (Google Gemini, gratis) ---
# Key gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelo a usar. Si Google deprecara este id, actualizar acá nomás.
GEMINI_MODEL=gemini-3.6-flash

# --- Fuentes de datos (ingestion/) ---
TMDB_API_KEY=
# Google Books funciona sin key con rate limit bajo; con key el limite es mayor.
GOOGLE_BOOKS_API_KEY=

# --- RAG (rag/) ---
CHROMA_PERSIST_DIR=./data/chroma
DATASET_CSV_PATH=./data/dataset.csv
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
